{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "../apps/api/src/*"
      ],
      "@durable-dav/background": [
        "../apps/background/src"
      ],
      "@durable-dav/background/*": [
        "../apps/background/src/*"
      ],
      "@durable-dav/backend-data": [
        "../packages/backend-data/src"
      ],
      "@durable-dav/backend-data/*": [
        "../packages/backend-data/src/*"
      ],
      "@durable-dav/backend-errors": [
        "../packages/backend-errors/src"
      ],
      "@durable-dav/backend-errors/*": [
        "../packages/backend-errors/src/*"
      ],
      "@durable-dav/backend-runtime": [
        "../packages/backend-runtime/src"
      ],
      "@durable-dav/backend-runtime/*": [
        "../packages/backend-runtime/src/*"
      ],
      "@durable-dav/backend-services": [
        "../packages/backend-services/src"
      ],
      "@durable-dav/backend-services/*": [
        "../packages/backend-services/src/*"
      ],
      "@durable-dav/shared": [
        "../packages/shared/src"
      ],
      "@durable-dav/shared/*": [
        "../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../src/**/*.ts"
  ]
}
