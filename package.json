{
  "name": "@durable-dav/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm exec tsx scripts/ensure-spa-shell-stub.ts && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm -r typecheck && pnpm run lint && pnpm run check:god-files && pnpm run verify:spa-shell",
    "checks:all": "pnpm run checks && pnpm run test:coverage",
    "check:god-files": "pnpm exec tsx scripts/check-god-files.ts --fail-on-hard",
    "verify:spa-shell": "pnpm exec tsx scripts/verify-spa-shell.ts",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint --fix --quiet .",
    "validate:locales": "pnpm exec tsx scripts/validate-locales.ts apps/web/src/locales --call-sites=apps/web/src --tags=apps/web/src/i18n.ts",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@rexezuge/d1": "^1.9.0",
    "@rexezuge/errors": "^1.9.0",
    "@rexezuge/i18n": "^1.9.0",
    "@rexezuge/identity": "^1.9.0",
    "@rexezuge/http": "^1.9.0",
    "@rexezuge/runtime": "^1.9.0",
    "@rexezuge/shared": "^1.9.2",
    "@rexezuge/tooling": "^1.9.0",
    "@rexezuge/web": "^1.9.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "hono": "4.13.11",
    "i18next": "^26.5.11",
    "jsdom": "30.1.3",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "wrangler": "4.151.2"
  },
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  }
}
