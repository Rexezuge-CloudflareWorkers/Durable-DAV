{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "durable-dav",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "routes": [],
  "placement": {
    "mode": "off",
  },
  "assets": {
    "directory": "./apps/web/dist/",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAV_VOLUME",
        "class_name": "DavVolumeWorker",
      },
      {
        "name": "CRON_TASKS",
        "class_name": "CronTasksWorker",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1000000000",
      "new_sqlite_classes": ["DavVolumeWorker", "CronTasksWorker"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "durable-dav-db",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  // No DEV_AUTH_EMAIL / DEMO_MODE here on purpose. Those are authentication
  // bypasses: with either set, every unauthenticated request authenticates as
  // that identity. They are guarded by `ENVIRONMENT !== "production"`, but
  // shipping a ready-made bypass identity inside the production template makes
  // a one-word edit (`ENVIRONMENT: "staging"`, or an `env.staging` block that
  // inherits `vars`) a full account takeover with no attacker effort. Set them
  // only in a non-production environment block, via a secret.
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_VOLUMES_PER_USER": "100",
    "MAX_CREDENTIALS_PER_VOLUME": "10",
    "DEFAULT_CREDENTIAL_EXPIRY_DAYS": "365",
    "MAX_CREDENTIAL_EXPIRY_DAYS": "365",
    "MAX_FILE_BYTES": "52428800",
    "DO_DEVICE_BYTES": "5368709120",
    "DAV_CACHE_TTL_SECONDS": "300",
  },
}
