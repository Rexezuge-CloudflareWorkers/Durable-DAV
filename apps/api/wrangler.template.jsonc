{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duradav",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "minify": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [],
  "placement": {
    "mode": "off"
  },
  "assets": {
    "directory": "./apps/web/dist/"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DAV_VOLUME",
        "class_name": "DavVolumeWorker"
      },
      {
        "name": "CRON_TASKS",
        "class_name": "CronTasksWorker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1000000000",
      "new_sqlite_classes": ["DavVolumeWorker", "CronTasksWorker"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "duradav-db"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "SITE_URL": "",
    "POLICY_AUD": "",
    "TEAM_DOMAIN": "",
    "MAX_VOLUMES_PER_USER": "100",
    "MAX_TOKENS_PER_USER": "5",
    "MAX_TOKEN_EXPIRY_DAYS": "90",
    "MAX_TOKEN_VOLUME_GRANTS": "100",
    "MAX_TOKEN_REPO_GRANTS": "50",
    "MAX_FILE_BYTES": "52428800",
    "DO_DEVICE_BYTES": "5368709120",
    "DEV_AUTH_EMAIL": "test@example.com"
  }
}
