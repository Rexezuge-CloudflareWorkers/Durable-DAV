{
  "name": "@durable-dav/backend-services",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts",
    "./identity": "./src/identity/index.ts",
    "./identity/*": "./src/identity/*.ts",
    "./composition": "./src/composition/index.ts",
    "./composition/*": "./src/composition/*.ts",
    "./errors": "./src/errors/index.ts",
    "./errors/*": "./src/errors/*.ts",
    "./dav": "./src/dav/index.ts",
    "./dav/*": "./src/dav/*.ts",
    "./replication": "./src/replication/index.ts",
    "./replication/*": "./src/replication/*.ts",
    "./replication/*/*": "./src/replication/*/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@durable-dav/backend-data": "workspace:*",
    "@durable-dav/backend-runtime": "workspace:*",
    "@durable-dav/shared": "workspace:*",
    "@rexezuge/d1": "^1.9.0",
    "@rexezuge/errors": "^1.9.2",
    "@rexezuge/http": "^1.9.0",
    "@rexezuge/identity": "^1.9.0",
    "@rexezuge/runtime": "^1.9.0",
    "@rexezuge/shared": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  }
}
